Step 4: Configure Alertmanager
Create Alertmanager configuration:

sudo nano /opt/alertmanager/alertmanager.yml
Add basic routing configuration:

global:
  resolve_timeout: 5m

# TODO: Configure route for alert routing
route:
  group_by: ['alertname', 'severity']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'default-receiver'

# TODO: Define receivers
receivers:
  - name: 'default-receiver'
    # For this lab, we'll use webhook for testing
    webhook_configs:
      - url: 'http://localhost:5001/webhook'
        send_resolved: true

# TODO: Add inhibit rules (optional)
inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
